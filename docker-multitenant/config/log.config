version: 1

formatters:
  precise:
    # `server_name` is injected by Synapse's LoggingContextFilter from the
    # current LoggingContext. In multi-tenant mode `effective_server_name`
    # is the active tenant's server_name (see synapse/http/site.py), so
    # this field doubles as the tenant identifier on every log line.
    format: '%(asctime)s [server_name=%(server_name)s] %(name)s - %(lineno)d - %(levelname)s - %(message)s'

handlers:
  console:
    class: logging.StreamHandler
    formatter: precise
    stream: ext://sys.stdout
  # Mirror logs to a file under the mounted /data/logs volume so the
  # test container can grep them for tenant context assertions.
  file:
    class: logging.handlers.RotatingFileHandler
    formatter: precise
    filename: /var/log/synapse/synapse.log
    maxBytes: 10485760  # 10 MB
    backupCount: 1

root:
  level: INFO
  handlers: [console, file]

loggers:
  synapse:
    level: INFO
  synapse.storage.SQL:
    level: WARNING
