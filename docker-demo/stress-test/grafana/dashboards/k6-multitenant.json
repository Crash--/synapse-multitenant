{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Virtual Users",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "alias": "VUs",
          "query": "SELECT last(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": { "fillOpacity": 20 }
        },
        "overrides": []
      }
    },
    {
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "alias": "req/s",
          "query": "SELECT non_negative_derivative(count(\"value\"), 1s) FROM \"http_reqs\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": { "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "alias": "errors",
          "query": "SELECT non_negative_derivative(count(\"value\"), 1s) FROM \"http_req_failed\" WHERE \"value\" = 1 AND $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "fillOpacity": 20 },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "title": "HTTP Request Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "alias": "p50",
          "query": "SELECT percentile(\"value\", 50) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(none)",
          "rawQuery": true,
          "refId": "A"
        },
        {
          "alias": "p95",
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(none)",
          "rawQuery": true,
          "refId": "B"
        },
        {
          "alias": "p99",
          "query": "SELECT percentile(\"value\", 99) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(none)",
          "rawQuery": true,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 5 }
        },
        "overrides": []
      }
    },
    {
      "title": "Message Send Duration by Tenant",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "alias": "$tag_tenant",
          "query": "SELECT percentile(\"value\", 95) FROM \"message_send_duration\" WHERE $timeFilter GROUP BY time($__interval), \"tenant\" fill(none)",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 5 }
        },
        "overrides": []
      }
    },
    {
      "title": "Timeline Read Duration by Tenant",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "alias": "$tag_tenant",
          "query": "SELECT percentile(\"value\", 95) FROM \"timeline_read_duration\" WHERE $timeFilter GROUP BY time($__interval), \"tenant\" fill(none)",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 5 }
        },
        "overrides": []
      }
    },
    {
      "title": "Rate Limited Responses",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "alias": "429s",
          "query": "SELECT non_negative_derivative(sum(\"value\"), 1s) FROM \"rate_limited_responses\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": { "fillOpacity": 20 },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "title": "Isolation Checks (pass rate)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 22 },
      "targets": [
        {
          "alias": "pass rate",
          "query": "SELECT last(\"value\") FROM \"isolation_check_passed\" WHERE $timeFilter",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1.0 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Checks Pass Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 22 },
      "targets": [
        {
          "alias": "checks",
          "query": "SELECT last(\"value\") FROM \"checks\" WHERE $timeFilter",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Iterations / sec",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "alias": "iter/s",
          "query": "SELECT non_negative_derivative(count(\"value\"), 1s) FROM \"iteration_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "custom": { "fillOpacity": 15 }
        },
        "overrides": []
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["k6", "multi-tenant", "synapse"],
  "templating": { "list": [] },
  "time": { "from": "now-10m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "k6 Multi-Tenant Stress Test",
  "uid": "k6-multitenant",
  "version": 1
}
